# Databasus API
DATABASUS_URL=https://backup.example.com
DATABASUS_EMAIL=automation@example.com
DATABASUS_SECRET=

# Target workspace + storage (UUIDs from Databasus UI / API)
WORKSPACE_ID=
STORAGE_ID=

# Optional notifier UUIDs attached on create (comma-separated)
# NOTIFIER_IDS=

# Tenant PG host (admin / CREATEROLE user)
PG_HOST=
PG_PORT=5432
PG_ADMIN_USER=
PG_ADMIN_SECRET=

# Extra databases to skip (the default system DB name is always skipped)
# PG_EXCLUDE_DATABASES=rdsadmin

# Backup schedule defaults (new DBs only; hash → slot inside the window)
BACKUP_INTERVAL_TYPE=DAILY
BACKUP_WINDOW_START=04:00
BACKUP_WINDOW_HOURS=4
BACKUP_SLOT_MINUTES=5
RETENTION_TIME_PERIOD=3_MONTH
CPU_COUNT=1
SSL_MODE=disable

# Cap simultaneous first backups per run (remaining use the schedule)
MAX_IMMEDIATE_BACKUPS=1

# Safety
# ALLOW_INSECURE_HTTP=true
# DRY_RUN=true
